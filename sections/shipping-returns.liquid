{{ 'pages.css' | asset_url | stylesheet_tag }}

<style>
.sr-hero-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem 2rem; margin-top: 2.5rem; padding-top: 1.75rem; border-top: 1px solid rgba(255,255,255,0.14); }
@media (max-width: 560px) {
  .sr-hero-stats { grid-template-columns: 1fr; gap: 0; }
  .sr-hero-stats > div { padding: 1rem 0; border-top: 1px solid rgba(255,255,255,0.1); }
  .sr-hero-stats > div:first-child { padding-top: 0; border-top: 0; }
}
.sr-hero-stat__value { font-size: 30px; font-weight: 500; letter-spacing: -.02em; color: var(--ez-light); line-height: 1.1; }
.sr-hero-stat__label { font-size: 13px; color: rgba(255,255,255,0.62); margin-top: 0.3rem; }

.free-shipping-strip__icon { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; background: rgba(254,211,0,0.18); flex-shrink: 0; }
</style>

{{ 'page-hero.css' | asset_url | stylesheet_tag }}

{% comment %} 1. HERO {% endcomment %}
{%- assign hero_image = section.settings.hero_image -%}
<section
  class="page-hero{% if hero_image != blank %} page-hero--has-image{% else %} page-hero--gradient{% endif %}"
  {% if hero_image != blank %}style="--hero-bg: url('{{ hero_image | image_url: width: 1800 }}')"{% endif %}>
  <div class="page-hero__inner container-shell">
    <nav class="page-hero__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="page-hero__breadcrumb-sep" aria-hidden="true">/</span>
      <span aria-current="page">{{ section.settings.breadcrumb_label }}</span>
    </nav>
    {% if section.settings.hero_kicker != blank %}
      <p class="page-hero__kicker"><span class="page-hero__pulse" aria-hidden="true"></span>{{ section.settings.hero_kicker }}</p>
    {% endif %}
    <h1 class="page-hero__heading">{{ section.settings.hero_heading }}{% if section.settings.hero_heading2 != blank %}<br>{{ section.settings.hero_heading2 }}{% endif %}</h1>
    {% if section.settings.hero_subheading != blank %}
      <p class="page-hero__subheading">{{ section.settings.hero_subheading }}</p>
    {% endif %}
    <div class="page-hero__actions">
      {% if section.settings.cta1_label != blank %}
        <a href="{{ section.settings.cta1_url | default: '/pages/contact' }}" class="page-hero__cta">{{ section.settings.cta1_label }}</a>
      {% endif %}
      {% if section.settings.cta2_label != blank %}
        <a href="{{ section.settings.cta2_url | default: '/pages/faq' }}" class="page-hero__cta-secondary">{{ section.settings.cta2_label }} <span aria-hidden="true">&rarr;</span></a>
      {% endif %}
    </div>
    <div class="sr-hero-stats">
      <div>
        <p class="sr-hero-stat__value">{{ section.settings.stat1_value }}</p>
        <p class="sr-hero-stat__label">{{ section.settings.stat1_label }}</p>
      </div>
      <div>
        <p class="sr-hero-stat__value">{{ section.settings.stat2_value }}</p>
        <p class="sr-hero-stat__label">{{ section.settings.stat2_label }}</p>
      </div>
      <div>
        <p class="sr-hero-stat__value">{{ section.settings.stat3_value }}</p>
        <p class="sr-hero-stat__label">{{ section.settings.stat3_label }}</p>
      </div>
    </div>
  </div>
</section>

{% comment %} 2. FREE SHIPPING STRIP {% endcomment %}
{% if section.settings.strip_text != blank %}
<div class="free-shipping-strip container-shell">
  <span class="free-shipping-strip__icon" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
      <path d="M8.5 3.5L3 10h5.5L7 16.5l9.5-9H11L12.5 3.5z" fill="var(--ez-amber)"/>
    </svg>
  </span>
  <p>{{ section.settings.strip_text }}</p>
</div>
{% endif %}

{% comment %} 3. 2-COL CONTENT {% endcomment %}
{%- assign us_rates = section.blocks | where: 'type', 'us_rate' -%}
{%- assign intl_rates = section.blocks | where: 'type', 'intl_rate' -%}
{%- assign steps = section.blocks | where: 'type', 'step' -%}
<section class="page-section page-section--white bg-white">
  <div class="two-col">

    <div>
      <p style="font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ez-grey);margin-bottom:1.25rem;">{{ section.settings.us_label }}</p>
      <div class="shipping-table-wrap">
        <table class="shipping-table">
          <thead><tr><th>{{ section.settings.col_total }}</th><th>{{ section.settings.col_rate }}</th><th>{{ section.settings.col_delivery }}</th></tr></thead>
          <tbody>
            {% for block in us_rates %}
              <tr {{ block.shopify_attributes }}><td>{{ block.settings.total }}</td><td{% if block.settings.is_free %} class="shipping-free"{% endif %}>{{ block.settings.rate }}</td><td>{{ block.settings.delivery }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <p style="font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ez-grey);margin:2rem 0 1.25rem;">{{ section.settings.intl_label }}</p>
      <div class="shipping-table-wrap">
        <table class="shipping-table">
          <thead><tr><th>{{ section.settings.col_total }}</th><th>{{ section.settings.col_rate }}</th><th>{{ section.settings.col_delivery }}</th></tr></thead>
          <tbody>
            {% for block in intl_rates %}
              <tr {{ block.shopify_attributes }}><td>{{ block.settings.total }}</td><td>{{ block.settings.rate }}</td><td>{{ block.settings.delivery }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% if section.settings.intl_note != blank %}
        <p style="font-size:12px;color:var(--ez-grey);margin-top:.75rem;line-height:1.5;">{{ section.settings.intl_note }}</p>
      {% endif %}
    </div>

    <div>
      <p style="font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ez-grey);margin-bottom:1.25rem;">{{ section.settings.returns_label }}</p>
      <div class="return-steps">
        {%- assign sn = 0 -%}
        {% for block in steps %}
          {%- assign sn = sn | plus: 1 -%}
          <div class="return-step" {{ block.shopify_attributes }}>
            <div class="return-step__num">{{ sn }}</div>
            <div>
              <p class="return-step__title">{{ block.settings.title }}</p>
              <p class="return-step__body">{{ block.settings.body }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
      {% if section.settings.return_window_title != blank %}
        <div style="margin-top:2rem;padding:1.25rem;background:var(--ez-light);border-radius:14px;">
          <p style="font-size:13px;font-weight:500;color:var(--ez-black);margin-bottom:.375rem;">{{ section.settings.return_window_title }}</p>
          <p style="font-size:13px;color:var(--ez-grey);line-height:1.6;">{{ section.settings.return_window_body }}</p>
        </div>
      {% endif %}
    </div>

  </div>
</section>

{% comment %} 4. QUICK FAQ {% endcomment %}
{%- assign faqs = section.blocks | where: 'type', 'faq' -%}
{% if faqs.size > 0 %}
<section class="page-section page-section--white bg-white" style="border-top:0.5px solid rgba(0,0,0,0.07);">
  <div class="container-shell">
    <div style="margin-bottom:2rem;">
      {% if section.settings.faq_kicker != blank %}<p class="section-intro__kicker">{{ section.settings.faq_kicker }}</p>{% endif %}
      <h2 class="section-intro__heading section-intro__heading--left text-left">{{ section.settings.faq_heading }}</h2>
    </div>
    <div class="page-faq">
      {% for block in faqs %}
        <div class="page-faq-item" {{ block.shopify_attributes }}>
          <button class="page-faq-trigger" aria-expanded="false">
            {{ block.settings.question }}
            <svg class="page-faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          </button>
          <div class="page-faq-body">
            <div class="page-faq-content">{{ block.settings.answer }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% comment %} 5. RETURN POLICY HIGHLIGHTS {% endcomment %}
{%- assign policies = section.blocks | where: 'type', 'policy' -%}
{% if policies.size > 0 %}
<section class="page-section page-section--white bg-white" style="border-top:0.5px solid rgba(0,0,0,0.07);">
  <div class="container-shell">
    <div style="margin-bottom:1.5rem;">
      {% if section.settings.policy_kicker != blank %}<p class="section-intro__kicker">{{ section.settings.policy_kicker }}</p>{% endif %}
      <h2 class="section-intro__heading section-intro__heading--left text-left" style="font-size:clamp(1.25rem,2.5vw,1.75rem);">{{ section.settings.policy_heading }}</h2>
    </div>
    <ul class="sr-policy-list">
      {% for block in policies %}
        <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
      {% endfor %}
    </ul>
    {% if section.settings.policy_link_label != blank %}
      <a href="{{ section.settings.policy_link_url | default: '/pages/refund-policy' }}" class="sr-policy-link">{{ section.settings.policy_link_label }} &rarr;</a>
    {% endif %}
  </div>
</section>
{% endif %}

<style>
.sr-policy-list {
  padding: 0;
  margin: 0 0 1.5rem;
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: .625rem;
}
.sr-policy-list li {
  font-size: 14px;
  color: #3d3d3f;
  line-height: 1.65;
  padding-left: 1.375rem;
  position: relative;
}
.sr-policy-list li::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: var(--ez-amber);
  font-weight: 700;
}
.sr-policy-link {
  display: inline-block;
  font-size: 14px;
  font-weight: 500;
  color: var(--ez-black);
  text-decoration: underline;
  text-underline-offset: 3px;
}
</style>

{%- render 'page-cta',
  variant: 'light',
  kicker: section.settings.cta_kicker,
  heading: section.settings.cta_heading,
  subhead: section.settings.cta_subhead,
  primary_label: section.settings.cta_label,
  primary_url: section.settings.cta_url | default: '/pages/contact'
-%}

<script>
(function(){
  document.querySelectorAll('.page-faq-trigger').forEach(function(btn){
    btn.addEventListener('click', function(){
      var item = this.closest('.page-faq-item');
      var isOpen = item.classList.contains('is-open');
      document.querySelectorAll('.page-faq-item.is-open').forEach(function(el){
        el.classList.remove('is-open');
        el.querySelector('.page-faq-trigger').setAttribute('aria-expanded','false');
      });
      if(!isOpen){
        item.classList.add('is-open');
        this.setAttribute('aria-expanded','true');
      }
    });
  });
})();
</script>

{% schema %}
{
  "name": "Shipping & returns",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero background image" },
    { "type": "text", "id": "breadcrumb_label", "label": "Breadcrumb", "default": "Shipping & returns" },
    { "type": "text", "id": "hero_kicker", "label": "Kicker", "default": "Shipping & returns" },
    { "type": "text", "id": "hero_heading", "label": "Heading line 1", "default": "Fast Shipping." },
    { "type": "text", "id": "hero_heading2", "label": "Heading line 2", "default": "Easy Returns." },
    { "type": "textarea", "id": "hero_subheading", "label": "Subheading", "default": "Free shipping on all US orders over $90. 30-day hassle-free returns. 1–2 year limited warranty depending on product." },
    { "type": "text", "id": "cta1_label", "label": "Primary button label", "default": "Start a Return" },
    { "type": "url", "id": "cta1_url", "label": "Primary button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button label", "default": "Browse FAQ" },
    { "type": "url", "id": "cta2_url", "label": "Secondary button link" },
    { "type": "text", "id": "stat1_value", "label": "Stat 1 value", "default": "Free" },
    { "type": "text", "id": "stat1_label", "label": "Stat 1 label", "default": "shipping over $90 in the US" },
    { "type": "text", "id": "stat2_value", "label": "Stat 2 value", "default": "30" },
    { "type": "text", "id": "stat2_label", "label": "Stat 2 label", "default": "day return window" },
    { "type": "text", "id": "stat3_value", "label": "Stat 3 value", "default": "1–2 yr" },
    { "type": "text", "id": "stat3_label", "label": "Stat 3 label", "default": "limited warranty varies by product" },
    { "type": "header", "content": "Free shipping strip" },
    { "type": "text", "id": "strip_text", "label": "Strip text", "default": "Free shipping automatically applied on all US orders over $90 — no code needed." },
    { "type": "header", "content": "Shipping tables" },
    { "type": "text", "id": "us_label", "label": "US table label", "default": "US shipping rates" },
    { "type": "text", "id": "intl_label", "label": "International table label", "default": "International shipping" },
    { "type": "text", "id": "col_total", "label": "Column: order total", "default": "Order total" },
    { "type": "text", "id": "col_rate", "label": "Column: rate", "default": "Rate" },
    { "type": "text", "id": "col_delivery", "label": "Column: delivery", "default": "Delivery" },
    { "type": "textarea", "id": "intl_note", "label": "International note", "default": "International orders may be subject to customs duties and taxes — these are the responsibility of the recipient." },
    { "type": "header", "content": "How returns work" },
    { "type": "text", "id": "returns_label", "label": "Returns label", "default": "How returns work" },
    { "type": "text", "id": "return_window_title", "label": "Return window title", "default": "30-day return window" },
    { "type": "textarea", "id": "return_window_body", "label": "Return window body", "default": "Items must be returned within 30 days of delivery, unused, and in original packaging. Items showing signs of use may not be eligible for a full refund." },
    { "type": "header", "content": "FAQ" },
    { "type": "text", "id": "faq_kicker", "label": "Kicker", "default": "Common Questions" },
    { "type": "text", "id": "faq_heading", "label": "Heading", "default": "Shipping & Returns FAQ" },
    { "type": "header", "content": "Return policy highlights" },
    { "type": "text", "id": "policy_kicker", "label": "Kicker", "default": "Return Policy Highlights" },
    { "type": "text", "id": "policy_heading", "label": "Heading", "default": "What to Know Before You Return" },
    { "type": "text", "id": "policy_link_label", "label": "Policy link label", "default": "Read the full return & refund policy" },
    { "type": "url", "id": "policy_link_url", "label": "Policy link URL" },
    { "type": "header", "content": "Closing call to action" },
    { "type": "text", "id": "cta_kicker", "label": "CTA kicker", "default": "Support" },
    { "type": "text", "id": "cta_heading", "label": "CTA heading", "default": "Questions? We’re here." },
    { "type": "text", "id": "cta_subhead", "label": "CTA subheading", "default": "Our team responds within 1 business day." },
    { "type": "text", "id": "cta_label", "label": "CTA button label", "default": "Contact Support" },
    { "type": "url", "id": "cta_url", "label": "CTA button link" }
  ],
  "blocks": [
    { "type": "us_rate", "name": "US shipping row", "settings": [
      { "type": "text", "id": "total", "label": "Order total" },
      { "type": "text", "id": "rate", "label": "Rate" },
      { "type": "text", "id": "delivery", "label": "Delivery" },
      { "type": "checkbox", "id": "is_free", "label": "Show rate as free", "default": false }
    ]},
    { "type": "intl_rate", "name": "International shipping row", "settings": [
      { "type": "text", "id": "total", "label": "Order total" },
      { "type": "text", "id": "rate", "label": "Rate" },
      { "type": "text", "id": "delivery", "label": "Delivery" }
    ]},
    { "type": "step", "name": "Return step", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "body", "label": "Body" }
    ]},
    { "type": "faq", "name": "FAQ item", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "textarea", "id": "answer", "label": "Answer" }
    ]},
    { "type": "policy", "name": "Policy highlight", "settings": [
      { "type": "text", "id": "text", "label": "Text" }
    ]}
  ],
  "max_blocks": 50
}
{% endschema %}
