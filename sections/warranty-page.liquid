{{ 'support-cluster.css' | asset_url | stylesheet_tag }}

<div class="support-body pt-[clamp(48px,6vw,80px)] pb-[clamp(48px,6vw,80px)]">
  <div class="container-shell">
    <div class="warranty-layout grid [grid-template-columns:minmax(0,1fr)_340px] gap-[clamp(2rem,5vw,4rem)] items-start max-[900px]:grid-cols-1">

    <div class="warranty-policy space-y-6">

      <div class="warranty-panel warranty-panel--intro">
        <p class="text-xs font-semibold tracking-[.1em] uppercase text-[var(--ez-grey)] mb-3">{{ section.settings.intro_eyebrow | default: 'Warranty coverage' }}</p>
        <h2 class="text-[clamp(1.75rem,3vw,2.5rem)] font-medium tracking-[-.03em] leading-[1.05] text-[var(--ez-black)] mb-3">{{ section.settings.intro_heading | default: 'Clear Coverage, Simple Claim Steps, No Guesswork.' }}</h2>
        <p class="text-sm md:text-base leading-[1.75] text-[var(--ez-grey)] max-w-3xl m-0">
          {{ section.settings.intro_copy | default: 'Review what is covered, what is excluded, and exactly how to submit a claim. If a product issue is actually a setup or compatibility problem, we’ll point you to support before you waste time filing the wrong request.' }}
        </p>
      </div>

      <div class="warranty-panel warranty-panel--stats">
        <p class="text-xs font-semibold tracking-[.1em] uppercase text-[var(--ez-grey)] mb-4">{{ section.settings.stats_heading | default: 'Coverage at a glance' }}</p>
        <div class="warranty-stat-row">
          <div class="warranty-stat">
            <span class="warranty-stat__label">{{ section.settings.stat1_label | default: 'Coverage' }}</span>
            <span class="warranty-stat__number">{{ section.settings.stat1_number | default: '1–2 Year' }}</span>
            <span class="warranty-stat__copy">{{ section.settings.stat1_copy | default: 'Varies by product family' }}</span>
          </div>
          <div class="warranty-stat">
            <span class="warranty-stat__label">{{ section.settings.stat2_label | default: 'Returns' }}</span>
            <span class="warranty-stat__number">{{ section.settings.stat2_number | default: '30 Days' }}</span>
            <span class="warranty-stat__copy">{{ section.settings.stat2_copy | default: 'From delivery' }}</span>
          </div>
          <div class="warranty-stat">
            <span class="warranty-stat__label">{{ section.settings.stat3_label | default: 'Claim shipping' }}</span>
            <span class="warranty-stat__number">{{ section.settings.stat3_number | default: 'Free' }}</span>
            <span class="warranty-stat__copy">{{ section.settings.stat3_copy | default: 'On valid claims' }}</span>
          </div>
        </div>
      </div>

      <div class="warranty-proof-grid grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="warranty-panel rounded-[24px] border border-black/[7%] bg-white p-6 md:p-7 shadow-[0_12px_40px_rgba(15,23,42,.03)]">
          <h2 class="warranty-section__heading text-xs font-semibold tracking-[.1em] uppercase text-[var(--ez-grey)] mb-4">{{ section.settings.covered_heading | default: 'What is covered' }}</h2>
          {%- assign covered_items = section.settings.covered_items | default: 'Manufacturing defects in materials and workmanship
Material failures under normal use
Premature wear under normal operating conditions
Functional issues not caused by user error or physical damage' | newline_to_br | split: '<br />' -%}
          <ul class="warranty-list warranty-list--covered p-0 m-0 list-none flex flex-col gap-[.625rem]">
            {%- for item in covered_items -%}
              {%- assign item_text = item | strip -%}
              {%- if item_text != blank -%}<li>{{ item_text }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        </div>

        <div class="warranty-panel rounded-[24px] border border-black/[7%] bg-white p-6 md:p-7 shadow-[0_12px_40px_rgba(15,23,42,.03)]">
          <h2 class="warranty-section__heading text-xs font-semibold tracking-[.1em] uppercase text-[var(--ez-grey)] mb-4">{{ section.settings.excluded_heading | default: 'What is not covered' }}</h2>
          {%- assign excluded_items = section.settings.excluded_items | default: 'Physical damage from drops or impact
Liquid damage
Damage from non-standard use or modifications
Normal wear after the warranty period expires
Loss or theft' | newline_to_br | split: '<br />' -%}
          <ul class="warranty-list warranty-list--excluded p-0 m-0 list-none flex flex-col gap-[.625rem]">
            {%- for item in excluded_items -%}
              {%- assign item_text = item | strip -%}
              {%- if item_text != blank -%}<li>{{ item_text }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>

      <div class="warranty-panel">
        <h2 class="warranty-section__heading text-xs font-semibold tracking-[.1em] uppercase text-[var(--ez-grey)] mb-4">{{ section.settings.claim_steps_heading | default: 'How to file a claim' }}</h2>
        <ol class="warranty-steps">
          <li>
            <span class="warranty-step__number">1</span>
            <div class="warranty-step__content">
              <strong>Email us or use the support form</strong>
              <p>Email <a href="mailto:support@ezq.com" class="underline" style="color:var(--ez-grey)">support@ezq.com</a> with "Warranty Claim" in the subject line, or use the <a href="/pages/contact" class="underline" style="color:var(--ez-grey)">contact form</a>.</p>
            </div>
          </li>
          <li>
            <span class="warranty-step__number">2</span>
            <div class="warranty-step__content">
              <strong>Provide proof of purchase, serial number &amp; photos</strong>
              <p>Include your order number or receipt, the product serial number, and clear photos or a short video clearly showing the defect.</p>
            </div>
          </li>
          <li>
            <span class="warranty-step__number">3</span>
            <div class="warranty-step__content">
              <strong>Try our Smart Help Center first</strong>
              <p>Visit the <a href="/pages/support" class="underline" style="color:var(--ez-grey)">Smart Help Center</a> to self-troubleshoot — many warranty-seeming problems are resolved in minutes without a claim.</p>
            </div>
          </li>
          <li>
            <span class="warranty-step__number">4</span>
            <div class="warranty-step__content">
              <strong>We respond within 24 business hours</strong>
              <p>Our team reviews your claim and either approves it, requests additional information, or explains why coverage doesn't apply.</p>
            </div>
          </li>
          <li>
            <span class="warranty-step__number">5</span>
            <div class="warranty-step__content">
              <strong>Approved claims: replacement or refund</strong>
              <p>Approved claims receive a refurbished replacement or, when available, a new item — shipped at no cost. If no replacement is available, a refund is issued.</p>
            </div>
          </li>
        </ol>
        <p style="margin-top:1.5rem;margin-bottom:0;font-size:13px;">
          <a href="{{ section.settings.terms_url | default: '/policies/refund-policy' }}" style="color:var(--ez-grey);text-decoration:underline;text-underline-offset:2px;">{{ section.settings.terms_label | default: 'Read full warranty terms' }} &rarr;</a>
        </p>
      </div>

    </div>

      <div class="warranty-claim-col lg:sticky lg:top-24">

      <div class="warranty-claim-card border-[1.5px] border-black/[7%] rounded-[24px] p-8 bg-white shadow-[0_18px_55px_rgba(15,23,42,.06)]">
        <div class="warranty-claim-card__icon w-12 h-12 rounded-[14px] bg-black/[4%] text-[var(--ez-grey)] flex items-center justify-center mb-5" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
            <path d="M14 4l9 3.5V14c0 5.25-3.75 8.25-9 10.5C9.75 22.25 5 20.25 5 14V7.5L14 4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M10 14l2.5 2.5 5.5-5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <p class="warranty-claim-card__eyebrow text-xs font-semibold tracking-[.1em] uppercase text-[var(--ez-grey)] mb-2">{{ section.settings.claim_eyebrow | default: 'Claim Support' }}</p>
        <h3 class="warranty-claim-card__heading text-xl font-medium tracking-[-0.02em] text-[var(--ez-black)] m-0 mb-[.625rem]">{{ section.settings.claim_heading | default: 'Start a warranty claim' }}</h3>
        <p class="warranty-claim-card__body text-sm text-[var(--ez-grey)] leading-[1.65] m-0 mb-6">
          {{ section.settings.claim_body | default: 'If your product has a defect covered under the limited warranty, contact us here. We respond within 1 business day on weekdays.' }}
        </p>
        <div class="warranty-claim-card__actions flex flex-col gap-3">
          {% render 'button', label: section.settings.claim_button_label | default: 'Submit a Claim', url: section.settings.claim_button_url | default: '/pages/contact', style: 'primary', size: 'sm', class: 'warranty-claim-card__button' %}
          <p class="warranty-claim-card__note text-xs text-[var(--ez-grey)] text-left m-0">{{ section.settings.claim_note | default: "Have your order number ready — we'll ask for it." }}</p>
        </div>
      </div>

      <div class="info-card rounded-[18px] p-6 flex gap-5 items-start bg-white shadow-[0_12px_28px_rgba(15,23,42,.05)]" style="margin-top:1rem">
        <div class="info-card__icon w-9 h-9 rounded-[10px] flex items-center justify-center shrink-0 bg-black/[4%] text-[var(--ez-grey)]">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M9 2l1.5 4.5H15l-3.75 2.75 1.5 4.5L9 11l-3.75 2.75 1.5-4.5L3 6.5h4.5L9 2z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
          </svg>
        </div>
        <div>
          <p class="info-card__title text-base font-medium text-[var(--ez-black)] mb-1 tracking-[-0.01em]">{{ section.settings.info1_title | default: '30-day no-questions return' }}</p>
          <p class="info-card__body text-sm text-[var(--ez-grey)] leading-[1.6] m-0">
            {{ section.settings.info1_body | default: 'Not the right fit? Return any product within 30 days of delivery — unused, in original packaging.' }}
          </p>
        </div>
      </div>

      <div class="info-card rounded-[18px] p-6 flex gap-5 items-start bg-white shadow-[0_12px_28px_rgba(15,23,42,.05)]" style="margin-top:1rem">
        <div class="info-card__icon w-9 h-9 rounded-[10px] flex items-center justify-center shrink-0 bg-black/[4%] text-[var(--ez-grey)]">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M2 5.5A1.5 1.5 0 013.5 4h11A1.5 1.5 0 0116 5.5v7A1.5 1.5 0 0114.5 14h-11A1.5 1.5 0 012 12.5v-7z" stroke="currentColor" stroke-width="1.25"/>
            <path d="M2 6.5l7 4.5 7-4.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
          </svg>
        </div>
        <div>
          <p class="info-card__title text-base font-medium text-[var(--ez-black)] mb-1 tracking-[-0.01em]">{{ section.settings.info2_title | default: 'Questions about coverage?' }}</p>
          <p class="info-card__body text-sm text-[var(--ez-grey)] leading-[1.6] m-0">
            {{ section.settings.info2_body | default: "Email or call us and we'll confirm your warranty status and walk you through the next step." }}
          </p>
        </div>
      </div>

      </div>
    </div>
  </div>
</div>

