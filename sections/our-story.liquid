{{ 'pages.css' | asset_url | stylesheet_tag }}
{{ 'page-hero.css' | asset_url | stylesheet_tag }}

{% comment %} 1. HERO {% endcomment %}
{% assign story_hero_image = section.settings.hero_image %}
<section class="page-hero-dark{% if story_hero_image != blank %} page-hero-dark--has-image{% else %} page-hero--gradient{% endif %}">
  {% if story_hero_image != blank %}
    <div class="page-hero-dark__media" aria-hidden="true">
      {{ story_hero_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', alt: '', class: 'page-hero-dark__image' }}
    </div>
  {% endif %}
  <div class="container-shell">
    <div class="story-hero-copy" data-animate>
    <nav class="page-hero__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="page-hero__breadcrumb-sep" aria-hidden="true">/</span>
      <span aria-current="page">Our story</span>
    </nav>
    <p class="page-hero-dark__kicker"><span class="page-hero__pulse" aria-hidden="true"></span>Est. 1994 · Yorba Linda, California</p>
    <h1 class="page-hero-dark__heading">
      Built for people who connect everything.
    </h1>
    <p class="page-hero-dark__body">
      Since 1994, EZQuest has made it simpler to connect the devices that matter most —
      with products built to last and a team that stands behind every one.
    </p>
    <div class="page-hero__actions">
      <a href="{{ routes.collections_url }}" class="page-hero__cta">Shop products</a>
      <a href="/pages/contact" class="page-hero__cta-secondary">Contact us <span aria-hidden="true">&rarr;</span></a>
    </div>
    {%- comment -%} Stats relocated to a dedicated band below the hero {%- endcomment -%}
    </div>
  </div>
</section>

{% comment %} 1b. STATS BAND {% endcomment %}
<section class="page-section page-section--grey story-stats-section">
  <div class="container-shell">
    <div class="story-stats-band">
      <div class="story-stat" data-animate>
        <p class="story-stat__value">30+</p>
        <p class="story-stat__label">Years in business</p>
      </div>
      <div class="story-stat" data-animate>
        <p class="story-stat__value">100+</p>
        <p class="story-stat__label">Products made</p>
      </div>
      <div class="story-stat" data-animate>
        <p class="story-stat__value">1–2yr</p>
        <p class="story-stat__label">Limited warranty (varies by product)</p>
      </div>
    </div>
  </div>
</section>

{% comment %} 2. NARRATIVE — official Our Story {% endcomment %}
<section class="page-section page-section--white bg-white">
  <div class="container-shell">
    <div class="story-narrative" data-animate>
      <div class="story-narrative__aside">
        <span class="about-narrative__rule" aria-hidden="true"></span>
        <p class="about-narrative__kicker">Our story</p>
      </div>
      <div class="story-narrative__body">
      <p class="story-narrative__lead">Technology has changed dramatically since EZQuest was founded in 1994. We’ve witnessed the evolution from SCSI to USB, FireWire, Thunderbolt, USB-C, USB4, and beyond. Through every generation of innovation, one thing has remained unchanged: our commitment to designing products that solve real problems for real people.</p>
      <p>EZQuest began with a simple belief — that great products don’t start with engineering drawings. <mark class="ez-hl">They start by listening.</mark></p>
      <p>Founder Ebrahim Zmehrir, an electronics engineer with a lifelong passion for designing and building technology, established EZQuest with a vision of making computer connectivity easier, more reliable, and more intuitive. Long before starting the company, Ebrahim was designing circuit boards, building electronic devices from individual components, and creating custom enclosures. His passion wasn’t simply building electronics — it was creating products that made people stop and say, “Wow, that’s exactly what I needed.”</p>
      <p>As technology evolved, so did EZQuest. During the transition from analog to digital video editing, EZQuest became one of the pioneers in FireWire storage solutions. Our products were showcased by Apple at Macworld San Francisco, helping creative professionals embrace the future of digital workflows. Those early years established the foundation for what would become our defining philosophy: embrace new technology, solve meaningful problems, and never stop innovating.</p>
      <p>Today, our focus is on USB-C and Thunderbolt connectivity solutions — including hubs, docking stations, adapters, cables, power solutions, and other accessories that simplify everyday technology. But while our products have evolved, our philosophy has not.</p>
      <p>Every EZQuest product begins with customer feedback. We don’t design products based on assumptions or trends. We listen to professionals, creators, businesses, educators, and everyday users to understand their challenges before creating solutions. That’s why many of our products include thoughtful features customers didn’t even realize they needed — from detachable USB-C cables to reinforced strain reliefs engineered for long-term durability.</p>
      <p>We have never believed in creating “me-too” products. If a product already exists, our question isn’t, “Can we make one too?” It’s, “How can we make it better?” Every EZQuest product is designed to add meaningful value and deliver a better everyday experience.</p>
      <p>Perhaps the greatest compliment we receive isn’t an award — it’s hearing from customers who are still using products they purchased decades ago. Those conversations remind us why we do what we do.</p>
      <p class="story-narrative__closer">Our goal has never been to earn a sale.<br>Our goal is to <span class="story-narrative__accent">earn a fan</span>.<br><span class="story-narrative__sub">One customer at a time.</span></p>
      </div>
    </div>
  </div>
</section>

{% comment %} 3. CORE VALUES {% endcomment %}
<section class="page-section page-section--grey">
  <div class="container-shell">
    <div class="story-section-intro">
      <p class="section-intro__kicker story-section-intro__kicker text-left">What we believe</p>
      <h2 class="section-intro__heading story-section-intro__heading">Our core values.</h2>
    </div>
    <div class="values-bento">
      <div class="value-card value-card--1 value-card--feature" data-animate>
        <span class="value-card__num">01</span>
        <p class="value-card__title">We listen first</p>
        <p class="value-card__body">Every product begins with understanding our customers’ needs — not following market trends.</p>
      </div>
      <div class="value-card value-card--2" data-animate>
        <span class="value-card__num">02</span>
        <p class="value-card__title">We never build “me too” products</p>
        <p class="value-card__body">Every EZQuest product must improve upon what’s already available by adding meaningful value.</p>
      </div>
      <div class="value-card value-card--3" data-animate>
        <span class="value-card__num">03</span>
        <p class="value-card__title">Thoughtful engineering</p>
        <p class="value-card__body">Every detail matters — from internal components to packaging, durability, and user experience.</p>
      </div>
      <div class="value-card value-card--4" data-animate>
        <span class="value-card__num">04</span>
        <p class="value-card__title">Innovation with purpose</p>
        <p class="value-card__body">Technology should simplify life, not complicate it. Every feature should have a reason for existing.</p>
      </div>
      <div class="value-card value-card--5" data-animate>
        <span class="value-card__num">05</span>
        <p class="value-card__title">Building lifelong relationships</p>
        <p class="value-card__body">Our success isn’t measured by how many customers we have, but by how many people proudly recommend EZQuest to others.</p>
      </div>
    </div>
  </div>
</section>

{% comment %} 4. TIMELINE {% endcomment %}
<section class="page-section page-section--white bg-white">
  <div class="container-shell">
    <div class="story-section-intro">
      <p class="section-intro__kicker story-section-intro__kicker text-left">Our journey</p>
      <h2 class="section-intro__heading story-section-intro__heading">30 years of connectivity.</h2>
    </div>
    <div class="milestone-bento">
      {% if section.settings.timeline_image != blank %}
        <figure class="milestone-bento__media" data-animate>
          {{ section.settings.timeline_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: 'EZQuest products through the years', class: 'milestone-bento__img' }}
        </figure>
      {% endif %}
      {%- assign mi = 0 -%}
      {% for block in section.blocks %}
        {% if block.type == 'milestone' %}
          {%- assign mi = mi | plus: 1 -%}
          <div class="milestone-card milestone-card--{{ mi }}{% if mi == 1 %} milestone-card--feature{% endif %}" data-animate {{ block.shopify_attributes }}>
            <p class="milestone-card__year">{{ block.settings.year }}</p>
            <p class="milestone-card__title">{{ block.settings.title }}</p>
            <p class="milestone-card__body">{{ block.settings.body }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{%- render 'page-cta',
  variant: 'light',
  kicker: 'Our products',
  heading: 'Explore what we make.',
  subhead: 'Premium accessories for every desk, every device.',
  primary_label: 'Browse products',
  primary_url: routes.collections_url
-%}

{% schema %}
{
  "name": "Our Story",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "image_picker", "id": "timeline_image", "label": "Timeline image" }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Timeline milestone",
      "settings": [
        { "type": "text", "id": "year", "label": "Year" },
        { "type": "text", "id": "title", "label": "Milestone title" },
        { "type": "textarea", "id": "body", "label": "Description" }
      ]
    }
  ],
  "presets": [{
    "name": "Our Story",
    "blocks": [
      { "type": "milestone", "settings": { "year": "1994", "title": "EZQuest is founded", "body": "Started in Lake Forest, California with a focus on making connectivity simpler for Mac users." }},
      { "type": "milestone", "settings": { "year": "2000", "title": "Expansion into cables and adapters", "body": "Launched the DuraGuard cable line — Kevlar-reinforced cables that outlast everything else on the market." }},
      { "type": "milestone", "settings": { "year": "2012", "title": "USB-C era begins", "body": "Ahead of the industry, we began engineering USB-C hubs and adapters before most manufacturers recognized the shift." }},
      { "type": "milestone", "settings": { "year": "2018", "title": "GaN charging technology", "body": "Introduced the UltimatePower GaN charger line — smaller, faster, and cooler than anything available at the time." }},
      { "type": "milestone", "settings": { "year": "2024", "title": "Thunderbolt 5 and USB4 V2", "body": "First to market with full Thunderbolt 5 docking station support — 120Gbps bandwidth for the next generation of creative professionals." }}
    ]
  }]
}
{% endschema %}
