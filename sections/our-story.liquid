{{ 'pages.css' | asset_url | stylesheet_tag }}
{{ 'page-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'story-hero-slider.js' | asset_url }}" defer></script>

{% comment %} 1. HERO — background slider (slides = section blocks) {% endcomment %}
{% assign story_hero_image = section.settings.hero_image %}
{% assign story_slides = section.blocks | where: 'type', 'slide' %}
<section class="page-hero-dark{% if story_slides.size > 0 or story_hero_image != blank %} page-hero-dark--has-image{% else %} page-hero--gradient{% endif %}">
  {% if story_slides.size > 0 %}
    <div class="story-hero-slider" data-story-slider data-autoplay="{{ section.settings.slider_autoplay | default: true }}" data-interval="{{ section.settings.slider_interval | default: 6 }}" aria-hidden="true">
      {% for block in story_slides %}
        {%- liquid
          assign slide_i = forloop.index
          assign fallback_desktop = 'story-slide-' | append: slide_i | append: '-desktop.jpg'
          assign fallback_mobile  = 'story-slide-' | append: slide_i | append: '-mobile.jpg'
        -%}
        <div class="story-hero-slide{% if forloop.first %} is-active{% endif %}" data-story-slide {{ block.shopify_attributes }}>
          <picture>
            {% if block.settings.image_mobile != blank %}
              <source media="(max-width: 767px)" srcset="{{ block.settings.image_mobile | image_url: width: 900 }}">
            {% elsif slide_i <= 5 %}
              <source media="(max-width: 767px)" srcset="{{ fallback_mobile | asset_url }}">
            {% endif %}
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 2400 }}" alt="" class="page-hero-dark__image" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"{% if forloop.first %} fetchpriority="high"{% endif %} width="2400" height="1200">
            {% elsif slide_i <= 5 %}
              <img src="{{ fallback_desktop | asset_url }}" alt="" class="page-hero-dark__image" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"{% if forloop.first %} fetchpriority="high"{% endif %} width="2400" height="1200">
            {% endif %}
          </picture>
        </div>
      {% endfor %}
    </div>
    {% if story_slides.size > 1 %}
      <div class="story-hero-dots" data-story-dots role="tablist" aria-label="Hero slides">
        {% for block in story_slides %}
          <button type="button" class="story-hero-dot{% if forloop.first %} is-active{% endif %}" data-story-dot="{{ forloop.index0 }}" role="tab" aria-label="Slide {{ forloop.index }}"{% if forloop.first %} aria-selected="true"{% endif %}></button>
        {% endfor %}
      </div>
    {% endif %}
  {% elsif story_hero_image != blank %}
    <div class="page-hero-dark__media" aria-hidden="true">
      {{ story_hero_image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', alt: '', class: 'page-hero-dark__image' }}
    </div>
  {% endif %}
  <div class="container-shell">
    <div class="story-hero-copy" data-animate>
    <nav class="page-hero__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="page-hero__breadcrumb-sep" aria-hidden="true">/</span>
      <span aria-current="page">{{ section.settings.breadcrumb_label }}</span>
    </nav>
    {% if section.settings.hero_kicker != blank %}
      <p class="page-hero-dark__kicker"><span class="page-hero__pulse" aria-hidden="true"></span>{{ section.settings.hero_kicker }}</p>
    {% endif %}
    <h1 class="page-hero-dark__heading">
      {{ section.settings.hero_heading }}
    </h1>
    {% if section.settings.hero_body != blank %}
      <p class="page-hero-dark__body">
        {{ section.settings.hero_body }}
      </p>
    {% endif %}
    <div class="page-hero__actions">
      {% if section.settings.hero_cta_label != blank %}
        <a href="{{ section.settings.hero_cta_url | default: routes.collections_url }}" class="page-hero__cta">{{ section.settings.hero_cta_label }}</a>
      {% endif %}
      {% if section.settings.hero_cta2_label != blank %}
        <a href="{{ section.settings.hero_cta2_url | default: '/pages/contact' }}" class="page-hero__cta-secondary">{{ section.settings.hero_cta2_label }} <span aria-hidden="true">&rarr;</span></a>
      {% endif %}
    </div>
    </div>
  </div>
</section>

{% comment %} 1b. STATS BAND {% endcomment %}
{%- assign story_stats = section.blocks | where: 'type', 'stat' -%}
{% if story_stats.size > 0 %}
<section class="page-section page-section--grey story-stats-section">
  <div class="container-shell">
    <div class="story-stats-band">
      {% for block in story_stats %}
        <div class="story-stat" data-animate {{ block.shopify_attributes }}>
          <p class="story-stat__value">{{ block.settings.value }}</p>
          <p class="story-stat__label">{{ block.settings.label }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% comment %} 2. NARRATIVE — official Our Story {% endcomment %}
<section class="page-section page-section--white bg-white">
  <div class="container-shell">
    <div class="story-narrative" data-animate>
      <div class="story-narrative__aside">
        <span class="about-narrative__rule" aria-hidden="true"></span>
        <p class="about-narrative__kicker">{{ section.settings.narrative_kicker }}</p>
      </div>
      <div class="story-narrative__body">
      {% if section.settings.narrative_lead != blank %}
        <p class="story-narrative__lead">{{ section.settings.narrative_lead }}</p>
      {% endif %}
      {{ section.settings.narrative_body }}
      {% if section.settings.closer_line1 != blank or section.settings.closer_accent != blank %}
        <p class="story-narrative__closer">{{ section.settings.closer_line1 }}<br>{{ section.settings.closer_line2_pre }} <span class="story-narrative__accent">{{ section.settings.closer_accent }}</span><br><span class="story-narrative__sub">{{ section.settings.closer_sub }}</span></p>
      {% endif %}
      </div>
    </div>
  </div>
</section>

{% comment %} 3. CORE VALUES {% endcomment %}
{%- assign value_blocks = section.blocks | where: 'type', 'value' -%}
{% if value_blocks.size > 0 %}
<section class="page-section page-section--grey">
  <div class="container-shell">
    <div class="story-section-intro">
      {% if section.settings.values_kicker != blank %}
        <p class="section-intro__kicker story-section-intro__kicker text-left">{{ section.settings.values_kicker }}</p>
      {% endif %}
      <h2 class="section-intro__heading story-section-intro__heading">{{ section.settings.values_heading }}</h2>
    </div>
    <div class="values-bento">
      {%- assign vi = 0 -%}
      {% for block in value_blocks %}
        {%- assign vi = vi | plus: 1 -%}
        <div class="value-card value-card--{{ vi }}{% if vi == 1 %} value-card--feature{% endif %}" data-animate {{ block.shopify_attributes }}>
          <span class="value-card__num">{{ vi | prepend: '0' }}</span>
          <p class="value-card__title">{{ block.settings.title }}</p>
          <p class="value-card__body">{{ block.settings.body }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% comment %} 4. TIMELINE {% endcomment %}
{%- assign milestones = section.blocks | where: 'type', 'milestone' -%}
{% if milestones.size > 0 %}
<section class="page-section page-section--white bg-white">
  <div class="container-shell">
    <div class="story-section-intro">
      {% if section.settings.timeline_kicker != blank %}
        <p class="section-intro__kicker story-section-intro__kicker text-left">{{ section.settings.timeline_kicker }}</p>
      {% endif %}
      <h2 class="section-intro__heading story-section-intro__heading">{{ section.settings.timeline_heading }}</h2>
    </div>
    <div class="milestone-bento">
      {% if section.settings.timeline_image != blank %}
        <figure class="milestone-bento__media" data-animate>
          {{ section.settings.timeline_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: 'EZQuest products through the years', class: 'milestone-bento__img' }}
        </figure>
      {% endif %}
      {%- assign mi = 0 -%}
      {% for block in milestones %}
        {%- assign mi = mi | plus: 1 -%}
        <div class="milestone-card milestone-card--{{ mi }}{% if mi == 1 %} milestone-card--feature{% endif %}" data-animate {{ block.shopify_attributes }}>
          <p class="milestone-card__year">{{ block.settings.year }}</p>
          <p class="milestone-card__title">{{ block.settings.title }}</p>
          <p class="milestone-card__body">{{ block.settings.body }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{%- render 'page-cta',
  variant: 'light',
  kicker: section.settings.cta_kicker,
  heading: section.settings.cta_heading,
  subhead: section.settings.cta_subhead,
  primary_label: section.settings.cta_label,
  primary_url: routes.collections_url
