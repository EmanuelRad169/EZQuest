{% comment %} sections/reseller.liquid — Become a Reseller application {% endcomment %}
{{ 'support-cluster.css' | asset_url | stylesheet_tag }}

<div class="support-body container-shell pt-[clamp(48px,6vw,80px)] pb-[clamp(48px,6vw,80px)]">
  <div class="contact-panel rounded-3xl border border-black/[6%] bg-white p-6 lg:p-8">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold tracking-[.08em] uppercase text-[var(--ez-grey)] m-0">{{ section.settings.eyebrow | default: 'Application' }}</p>
      <h1 class="section-heading mt-4">{{ section.settings.heading | default: 'Tell us about your business' }}</h1>
      <p class="section-copy mt-4">{{ section.settings.copy | default: 'If you are a distributor, reseller, or retailer interested in carrying EZQuest products — or you would like to evaluate our products — share your details below and our partnerships team will be in touch shortly.' }}</p>
    </div>

    <div class="reseller-form-wrap mt-8 lg:mt-10">
      {% form 'contact', id: 'reseller-form', class: 'contact-form reseller-form' %}
        {% assign inp = 'contact-form__input py-3 px-4 border border-black/[12%] rounded-[10px] text-base text-[var(--ez-black)] bg-white w-full transition-[border-color,box-shadow] duration-200 outline-none appearance-none font-[inherit] focus:border-black/30 focus:shadow-[0_0_0_3px_rgba(15,23,42,.08)]' %}
        {% assign lbl = 'block text-sm font-semibold text-[var(--ez-black)] mb-2' %}

        {% if form.posted_successfully? %}
          <div class="contact-success py-6 px-6 border-[1.5px] border-[rgba(22,163,74,.3)] rounded-[12px] bg-[rgba(22,163,74,.05)] text-[var(--ez-black)]" role="status">
            <p class="font-semibold text-base m-0">Thanks — your reseller application has been received.</p>
            <p class="text-sm text-[var(--ez-grey)] mt-2 m-0">Our partnerships team will review your details and reply to your email within 1–2 business days.</p>
          </div>
        {% else %}
          {% if form.errors %}
            <div class="contact-errors py-4 px-5 border-[1.5px] border-[rgba(220,38,38,.25)] rounded-[10px] bg-[rgba(220,38,38,.04)] text-[#9a1c1f] text-sm mb-5" role="alert">{{ form.errors | default_errors }}</div>
          {% endif %}

          <div class="grid grid-cols-2 gap-5 max-[720px]:grid-cols-1">
            <div>
              <label class="{{ lbl }}" for="rs-company">Company name</label>
              <input class="{{ inp }}" type="text" id="rs-company" name="contact[Company name]" required placeholder="Acme Distribution LLC">
            </div>
            <div>
              <label class="{{ lbl }}" for="rs-name">Your name</label>
              <input class="{{ inp }}" type="text" id="rs-name" name="contact[name]" required autocomplete="name" placeholder="Alex Johnson" value="{% if customer %}{{ customer.name }}{% endif %}">
            </div>
            <div>
              <label class="{{ lbl }}" for="rs-email">Email</label>
              <input class="{{ inp }}" type="email" id="rs-email" name="contact[email]" required autocomplete="email" placeholder="alex@company.com" value="{% if customer %}{{ customer.email }}{% endif %}">
            </div>
            <div>
              <label class="{{ lbl }}" for="rs-phone">Telephone</label>
              <input class="{{ inp }}" type="tel" id="rs-phone" name="contact[Telephone]" autocomplete="tel" placeholder="(555) 123-4567">
            </div>
            <div>
              <label class="{{ lbl }}" for="rs-website">Website</label>
              <input class="{{ inp }}" type="text" id="rs-website" name="contact[Website]" placeholder="https://">
            </div>
            <div>
              <label class="{{ lbl }}" for="rs-years">Years in business</label>
              <input class="{{ inp }}" type="text" id="rs-years" name="contact[Years in business]" placeholder="e.g. 8">
            </div>
            <div class="col-span-2 max-[720px]:col-span-1">
              <label class="{{ lbl }}" for="rs-address">Address</label>
              <input class="{{ inp }}" type="text" id="rs-address" name="contact[Address]" autocomplete="street-address" placeholder="Street, City">
            </div>
            <div>
              <label class="{{ lbl }}" for="rs-state">State / Region</label>
              <input class="{{ inp }}" type="text" id="rs-state" name="contact[State]" autocomplete="address-level1" placeholder="CA">
            </div>
            <div>
              <label class="{{ lbl }}" for="rs-zip">ZIP / Postal code</label>
              <input class="{{ inp }}" type="text" id="rs-zip" name="contact[ZIP]" autocomplete="postal-code" placeholder="92887">
            </div>
            <div>
              <label class="{{ lbl }}" for="rs-productfocus">Business product focus</label>
              <input class="{{ inp }}" type="text" id="rs-productfocus" name="contact[Business product focus]" placeholder="e.g. Consumer electronics">
            </div>
            <div>
              <label class="{{ lbl }}" for="rs-servicefocus">Business service focus</label>
              <input class="{{ inp }}" type="text" id="rs-servicefocus" name="contact[Business service focus]" placeholder="e.g. Online retail, B2B">
            </div>
            <div class="col-span-2 max-[720px]:col-span-1">
              <label class="{{ lbl }}" for="rs-brands">Main brands carried</label>
              <input class="{{ inp }}" type="text" id="rs-brands" name="contact[Main brands carried]" placeholder="Brands you currently stock">
            </div>
          </div>

          <fieldset class="mt-6 border-0 p-0 m-0">
            <legend class="{{ lbl }} p-0">EZQuest product interest</legend>
            <div class="grid grid-cols-3 gap-3 mt-1 max-[720px]:grid-cols-1">
              {% assign interests = 'USB-C Hubs & Docks,GaN Chargers,DuraGuard Cables,Display Adapters,Card Readers,Bundles & Kits' | split: ',' %}
              {% for item in interests %}
                <label class="flex items-center gap-2.5 text-sm text-[var(--ez-black)] py-2 px-3 border border-black/[10%] rounded-[10px] cursor-pointer hover:border-black/25 transition-colors">
                  <input type="checkbox" name="contact[Interested in {{ item }}]" value="Yes" class="w-4 h-4 accent-[var(--ez-black)]">
                  <span>{{ item }}</span>
                </label>
              {% endfor %}
            </div>
          </fieldset>

          <div class="mt-6">
            <label class="{{ lbl }}" for="rs-about">About your business</label>
            <textarea class="{{ inp }} resize-y min-h-[120px]" id="rs-about" name="contact[body]" rows="5" required placeholder="Tell us about your business, your customers, and how you'd like to work with EZQuest."></textarea>
          </div>

          <button type="submit" class="btn btn--primary reseller-form__submit w-full mt-6 min-h-[52px] text-base rounded-full">Submit application</button>
          <p class="text-xs text-[var(--ez-grey)] text-center mt-3 m-0">We never share your information. See our <a href="/policies/privacy-policy" class="underline">privacy policy</a>.</p>
        {% endif %}
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reseller application",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Partnerships" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Become a Reseller" },
    { "type": "textarea", "id": "copy", "label": "Intro copy", "default": "If you are a distributor, reseller, or retailer interested in carrying EZQuest products — or you would like to evaluate our products — share your details below and our partnerships team will be in touch shortly." }
  ],
  "presets": [{ "name": "Reseller application" }]
}
{% endschema %}
