{{ 'support-cluster.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign resource_kind     = section.settings.resource_kind | default: 'downloads'
  assign structured_source = section.settings.structured_source | default: 'blocks'
  assign only_type_val     = section.settings.only_type

  comment
    Drivers page: rendered from a .liquid template with default section settings,
    so force it to the global Downloads metaobjects filtered to the "Driver" type.
  endcomment
  if page.handle == 'drivers'
    assign resource_kind = 'downloads'
    assign structured_source = 'global'
    assign only_type_val = 'Driver'
  endif

  case resource_kind
    when 'downloads'
      assign mo_type     = 'ezquest_download'
      assign type_field  = 'download_type'
    when 'manuals'
      assign mo_type     = 'ezquest_manual'
      assign type_field  = 'manual_type'
    when 'firmware'
      assign mo_type     = 'ezquest_firmware'
      assign type_field  = 'firmware_type'
    when 'guides'
      assign mo_type     = 'ezquest_user_guide'
      assign type_field  = 'guide_type'
  endcase

  if structured_source == 'global'
    assign mo_entries = shop.metaobjects[mo_type].values
  endif
-%}

<div class="support-body container-shell pt-20 pb-20">

  {%- if structured_source == 'global' -%}

    {%- comment -%} Build unique filter values from type field across all entries {%- endcomment -%}
    {%- assign raw_types = '' -%}
    {%- for entry in mo_entries -%}
      {%- assign t = entry[type_field].value -%}
      {%- if t != blank -%}
        {%- assign raw_types = raw_types | append: t | append: '||' -%}
      {%- endif -%}
    {%- endfor -%}
    {%- assign filter_types = raw_types | split: '||' | uniq | compact -%}

    {%- if section.settings.show_filters != false and only_type_val == blank -%}
    <div class="filter-pills flex gap-2 flex-wrap mb-8" id="dl-filters">
      <button class="filter-pill is-active" data-filter="all" type="button">All</button>
      {%- for type_label in filter_types -%}
        <button class="filter-pill" data-filter="{{ type_label | handleize }}" type="button">{{ type_label }}</button>
      {%- endfor -%}
    </div>
    {%- endif -%}

    <div class="dl-search-wrap" style="margin-bottom:1.25rem;">
      <input type="search" id="dl-search" placeholder="Search by product or file name…" aria-label="Search downloads" autocomplete="off"
        style="width:100%;max-width:440px;padding:11px 14px 11px 40px;border:1.5px solid rgba(0,0,0,.12);border-radius:12px;font-size:14px;background:#fff url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2216%22 height=%2216%22 fill=%22none%22 stroke=%22%2394969C%22 stroke-width=%221.6%22 stroke-linecap=%22round%22><circle cx=%227%22 cy=%227%22 r=%225%22/><path d=%22M11 11l3 3%22/></svg>') 13px center no-repeat;outline:none;" />
      <p id="dl-search-empty" class="data-table__meta" style="display:none;margin:.75rem 0 0;">No files match your search.</p>
    </div>

    <div class="data-table-wrap">
      <table class="data-table" id="dl-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>File name</th>
            <th>Type</th>
            <th>Compatible with</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {%- if mo_entries.size > 0 -%}
            {%- for entry in mo_entries -%}
              {%- assign type_val    = entry[type_field].value -%}
              {%- if only_type_val != blank and type_val != only_type_val -%}{%- continue -%}{%- endif -%}
              {%- assign file_url    = entry.file.value.url | default: entry.external_url.value -%}
              {%- assign product_obj = entry.products.value | first -%}
              {%- assign platforms   = entry.platforms.value | join: ' · ' -%}
              {%- if platforms == blank -%}{%- assign platforms = 'Mac · Windows' -%}{%- endif -%}
              <tr data-category="{{ type_val | handleize }}">
                <td data-label="Product">
                  {%- if product_obj -%}
                    <a href="{{ product_obj.url }}" class="product-pill product-pill--link">{{ product_obj.title }}</a>
                  {%- else -%}
                    <span class="product-pill">—</span>
                  {%- endif -%}
                </td>
                <td class="data-table__file" data-label="File">{{ entry.title.value }}</td>
                <td data-label="Type">
                  <span class="file-badge">{{ type_val | default: '—' }}</span>
                </td>
                <td class="data-table__meta" data-label="Compatible">{{ platforms }}</td>
                <td>
                  {%- if file_url != blank -%}
                    <a href="{{ file_url }}" class="btn-download" download aria-label="Download {{ entry.title.value }}">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 2v7m0 0L4.5 6.5M7 9l2.5-2.5M2 11h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      Download
                    </a>
                  {%- else -%}
                    <span class="data-table__meta">Available on request</span>
                  {%- endif -%}
                </td>
              </tr>
            {%- endfor -%}
          {%- else -%}
            <tr>
              <td colspan="6">
                <div class="empty-state">
                  <p class="empty-state__heading">Files are being uploaded</p>
                  <p class="empty-state__body">Check back shortly or contact us for direct file access.</p>
                  <a href="/pages/contact" class="btn btn--primary">Request a file</a>
                </div>
              </td>
            </tr>
          {%- endif -%}
        </tbody>
      </table>
    </div>

  {%- else -%}

    <div class="filter-pills flex gap-2 flex-wrap mb-8" id="dl-filters">
      <button class="filter-pill is-active" data-filter="all" type="button">All files</button>
      <button class="filter-pill" data-filter="quickstart" type="button">Quick Start</button>
      <button class="filter-pill" data-filter="driver" type="button">Drivers</button>
      <button class="filter-pill" data-filter="utility" type="button">Utilities</button>
    </div>

    <div class="data-table-wrap">
      <table class="data-table" id="dl-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>File name</th>
            <th>Type</th>
            <th>Size</th>
            <th>Compatible with</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            {% if block.type == 'file' %}
              <tr data-category="{{ block.settings.category | handleize }}" {{ block.shopify_attributes }}>
                <td data-label="Product">
                  <span class="product-pill">{{ block.settings.product_name }}</span>
                </td>
                <td class="data-table__file" data-label="File">{{ block.settings.file_title }}</td>
                <td data-label="Type">
                  {% assign ext = block.settings.file_url | split: '.' | last | upcase %}
                  {%- liquid
                    assign ext_class = 'file-badge--other'
                    case ext
                      when 'zip'
                        assign ext_class = 'file-badge--zip'
                      when 'exe'
                        assign ext_class = 'file-badge--exe'
                    endcase
                  -%}
                  <span class="file-badge {{ ext_class }}">{{ ext }}</span>
                </td>
                <td class="data-table__muted" data-label="Size">{{ block.settings.file_size }}</td>
                <td class="data-table__meta" data-label="Compatible">{{ block.settings.compatibility | default: 'Mac · Windows' }}</td>
                <td>
                  {% if block.settings.file_url != blank and block.settings.file_url != '#' %}
                    <a href="{{ block.settings.file_url }}" class="btn-download" download aria-label="Download {{ block.settings.file_title }}">
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 2v7m0 0L4.5 6.5M7 9l2.5-2.5M2 11h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      Download
                    </a>
                  {% else %}
                    <span class="data-table__meta">Available on request</span>
                  {% endif %}
                </td>
              </tr>
            {% endif %}
          {% endfor %}

          {% if section.blocks.size == 0 %}
            <tr>
              <td colspan="7">
                <div class="empty-state empty-state--panel">
                  <p class="empty-state__heading">Files are being uploaded</p>
                  <p class="empty-state__body">Check back shortly or contact us for direct file access.</p>
                  <a href="/pages/contact" class="btn btn--primary">Request a file</a>
                </div>
              </td>
            </tr>
          {% endif %}
        </tbody>
      </table>
    </div>

  {%- endif -%}

</div>

<script>
(function(){
  var currentFilter = 'all', currentSearch = '';
  function applyFilters(){
    var visible = 0;
    document.querySelectorAll('#dl-table tbody tr[data-category]').forEach(function(row){
      var okCat = (currentFilter === 'all' || row.dataset.category === currentFilter);
      var okSearch = (currentSearch === '' || row.textContent.toLowerCase().indexOf(currentSearch) !== -1);
      var show = okCat && okSearch;
      row.style.display = show ? '' : 'none';
      if (show) { visible++; }
    });
    var empty = document.getElementById('dl-search-empty');
    if (empty) { empty.style.display = (visible === 0) ? '' : 'none'; }
  }
  document.querySelectorAll('.filter-pill').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('.filter-pill').forEach(function(b){ b.classList.remove('is-active'); });
      this.classList.add('is-active');
      currentFilter = this.dataset.filter;
      applyFilters();
    });
  });
  var search = document.getElementById('dl-search');
  if (search) {
    search.addEventListener('input', function(){
      currentSearch = this.value.trim().toLowerCase();
      applyFilters();
    });
  }
})();
</script>

{% schema %}
{
  "name": "Downloads",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "resource_kind",
      "label": "Resource type",
      "info": "Determines which metaobject type to query and the hero text when using CMS source.",
      "options": [
        {"value": "downloads", "label": "Downloads"},
        {"value": "manuals",   "label": "Manuals"},
        {"value": "firmware",  "label": "Firmware"},
        {"value": "guides",    "label": "User guides"}
      ],
      "default": "downloads"
    },
    {
      "type": "select",
      "id": "structured_source",
      "label": "Content source",
      "info": "CMS pulls from metaobjects. Blocks uses the section blocks below (manual entry).",
      "options": [
        {"value": "blocks", "label": "Blocks (manual)"},
        {"value": "global", "label": "CMS (metaobjects)"}
      ],
      "default": "blocks"
    },
    { "type": "text", "id": "only_type", "label": "Only show this type", "info": "Optional. In CMS mode, limit the table to one download type, e.g. Manual, Data Sheet, Driver. Leave blank to show all." },
    { "type": "checkbox", "id": "show_filters", "label": "Show filter tabs", "default": true }
  ],
  "blocks": [
    {
      "type": "family",
      "name": "Product family",
      "settings": [
        {"type":"text","id":"label","label":"Family label"},
        {"type":"text","id":"handle","label":"Family handle"}
      ]
    },
    {
      "type": "file",
      "name": "File",
      "settings": [
        {"type":"text","id":"product_name","label":"Product name"},
        {"type":"text","id":"file_title","label":"File title"},
        {"type":"url","id":"file_url","label":"File URL"},
        {"type":"text","id":"file_size","label":"File size","placeholder":"2.1 MB"},
        {"type":"text","id":"version","label":"Version","placeholder":"v2.1.0"},
        {"type":"text","id":"compatibility","label":"Compatible with","default":"Mac · Windows"},
        {
          "type":"select","id":"category","label":"Category",
          "options":[
            {"value":"quickstart","label":"Quick Start"},
            {"value":"driver","label":"Driver"},
            {"value":"utility","label":"Utility"},
            {"value":"other","label":"Other"}
          ],
          "default":"quickstart"
        }
      ]
    }
  ],
  "presets": [{"name":"Downloads"}]
}
{% endschema %}
