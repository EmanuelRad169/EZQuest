{%- comment -%}
  Home confidence grid — merchant-editable trust cards.
  Blocks: "promise" (dark hero card, limit 1) + "card" (standard trust card).
  Add / remove / reorder / hide via the Theme Editor. Empty fields hide cleanly.
{%- endcomment -%}
<section class="section-shell pt-10 lg:pt-16 home-confidence-section">
  <div class="container-shell">

    <div class="home-confidence-grid mt-8 reveal-stagger">

      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'promise' -%}
            <article class="home-confidence-card home-confidence-card--hero" {{ block.shopify_attributes }}>
              <div class="home-confidence-hero-watermark" aria-hidden="true">
                <svg width="240" height="240" viewBox="0 0 18 18" fill="none">
                  <path d="M9 2.9 13.9 4.6v3.6c0 3-2 5.65-4.9 6.9-2.9-1.25-4.9-3.9-4.9-6.9V4.6L9 2.9Z" fill="#fff"/>
                </svg>
              </div>
              <div class="home-confidence-hero-copy">
                {%- if block.settings.eyebrow != blank -%}
                  <p class="home-confidence-hero-eyebrow">{{ block.settings.eyebrow }}</p>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <p class="home-confidence-hero-title">{{ block.settings.title }}</p>
                {%- endif -%}
                {%- if block.settings.subtext != blank -%}
                  <p class="home-confidence-hero-sub">{{ block.settings.subtext }}</p>
                {%- endif -%}
              </div>
              <div class="home-confidence-hero-bottom">
                <svg class="home-confidence-hero-badge" width="72" height="72" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                  <path d="M9 2.9 13.9 4.6v3.6c0 3-2 5.65-4.9 6.9-2.9-1.25-4.9-3.9-4.9-6.9V4.6L9 2.9Z" fill="var(--ez-amber,#FED300)"/>
                  <path d="M6.5 9.2L8.3 11l3.2-3.2" stroke="#111" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <div>
                  {%- if block.settings.badge_label != blank -%}
                    <p class="home-confidence-hero-badge-label">{{ block.settings.badge_label }}</p>
                  {%- endif -%}
                  {%- if block.settings.link_label != blank -%}
                    <a href="{{ block.settings.link_url | default: '/pages/warranty' }}" class="btn btn--link-on-dark">{{ block.settings.link_label }}</a>
                  {%- endif -%}
                </div>
              </div>
            </article>

          {%- when 'card' -%}
            <article class="home-confidence-card" {{ block.shopify_attributes }}>
              <div class="home-confidence-card-copy">
                {%- if block.settings.heading != blank -%}
                  <h3 class="home-confidence-card-title">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <p class="home-confidence-card-sub">{{ block.settings.body }}</p>
                {%- endif -%}
                {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
                  <a href="{{ block.settings.link_url }}" class="home-confidence-card-link">{{ block.settings.link_label }}</a>
                {%- endif -%}
              </div>
              <div class="home-confidence-card-icon" style="--icon-bg:{{ block.settings.icon_bg | default: '#FEF3C7' }};--icon-color:{{ block.settings.icon_color | default: '#92400E' }}">
                {% render 'icon', name: block.settings.icon, size: 28 %}
              </div>
            </article>

        {%- endcase -%}
      {%- endfor -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home confidence grid",
  "settings": [],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise card (dark)",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "EZQuest Promise" },
        { "type": "text", "id": "title", "label": "Title", "default": "1–2yr warranty" },
        { "type": "text", "id": "subtext", "label": "Subtext", "default": "Varies by product. No fine print." },
        { "type": "text", "id": "badge_label", "label": "Badge label", "default": "1–2yr coverage" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "View warranty" },
        { "type": "url", "id": "link_url", "label": "Link destination" }
      ]
    },
    {
      "type": "card",
      "name": "Trust card",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Fast shipping" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Orders ship within 1–2 business days with full tracking provided." },
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "truck",
          "options": [
            { "value": "truck", "label": "Truck (shipping)" },
            { "value": "refresh-cw", "label": "Arrows (returns)" },
            { "value": "file-text", "label": "Document (manuals)" },
            { "value": "support", "label": "Headset (support)" },
            { "value": "shield-check", "label": "Shield check (warranty)" },
            { "value": "download", "label": "Download" },
            { "value": "bolt", "label": "Bolt (power)" },
            { "value": "cable", "label": "Cable" },
            { "value": "battery-charging", "label": "Battery charging" }
          ]
        },
        { "type": "color", "id": "icon_bg", "label": "Icon background", "default": "#FEF3C7" },
        { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#92400E" },
        { "type": "text", "id": "link_label", "label": "Link label (optional)" },
        { "type": "url", "id": "link_url", "label": "Link destination (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home confidence grid",
      "blocks": [
        { "type": "card", "settings": { "heading": "Fast shipping", "body": "Orders ship within 1–2 business days with full tracking provided.", "icon": "truck", "icon_bg": "#FEF3C7", "icon_color": "#92400E" } },
        { "type": "promise" },
        { "type": "card", "settings": { "heading": "Easy returns", "body": "Hassle-free returns within 30 days. No questions asked.", "icon": "refresh-cw", "icon_bg": "#DBEAFE", "icon_color": "#1E40AF" } },
        { "type": "card", "settings": { "heading": "Manuals & downloads", "body": "Setup guides, firmware, and docs ready when you need them.", "icon": "file-text", "icon_bg": "#E0E7FF", "icon_color": "#3730A3" } },
        { "type": "card", "settings": { "heading": "Live support", "body": "Real humans, fast replies. Help by email, chat, or phone.", "icon": "support", "icon_bg": "#D1FAE5", "icon_color": "#065F46" } }
      ]
    }
  ]
}
{% endschema %}
