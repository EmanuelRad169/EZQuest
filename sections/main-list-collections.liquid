<section class="section-shell collections-index-section">
  <div class="container-shell">
    {%- liquid
      assign collection_group_titles = 'USB-C|Cables/Adapters|Power' | split: '|'
      assign collection_group_items = 'Hubs^hubs^usb-c-multimedia-7-in-1-hub|Cables^cables^duraguard-usb-c-to-usb-a-charge-and-sync-cable|Adapters^adapters^usb-c-to-hdmi-4k-60hz-adapter|Card Readers^usb-c-card-readers^usb-c-card-reader-ss42|Enclosure^usb-c-enclosures^magnetic-usb-c-m-2-nvme-ssd-enclosure||HDMI^hdmi-cables-adapters^ultra-hd-high-speed-certified-hdmi-8k-60hz-cable|DisplayPort^displayport-cables-adapters^usb-c-to-displayport-4k-60hz-cable|Mini DisplayPort^mini-displayport-cables^mini-displayport-to-hdmi-4k-60hz-cable|Audio^audio-cables^duraguard-stereo-audio-cable||Wall Charger^wall-chargers^worldtravel-65w-gan-5-port-pd-wall-charger|Car Charger^car-chargers^ultimatepower-usb-c-72w-car-charger-dual-port-with-display' | split: '||'
    -%}

    <div class="collections-index-header">
      <p class="section-kicker">{{ section.settings.kicker | default: 'Shop by Category' }}</p>
      <h2 class="collections-index-title">{{ section.settings.heading | default: 'Collections' }}</h2>
    </div>

    <div class="collections-directory">
      {% for collection_group_title in collection_group_titles %}
        {% assign collection_group_payload = collection_group_items[forloop.index0] | split: '|' %}
        <section class="collections-directory-group">
          <div class="collections-directory-group-head">
            <h2 class="collections-directory-group-title">{{ collection_group_title }}</h2>
            <div class="collections-directory-group-divider" aria-hidden="true"></div>
          </div>

          <div class="collections-grid reveal-stagger">
            {% for collection_group_item in collection_group_payload %}
              {%- liquid
                assign collection_group_parts = collection_group_item | split: '^'
                assign collection_card_title = collection_group_parts[0] | strip
                assign collection_card_handle = collection_group_parts[1] | strip
                assign collection_card_product = collection_group_parts[2] | strip
                assign collection_card_image = blank
                assign col = collections[collection_card_handle]

                if collection_card_title == 'Hubs'
                  assign collection_card_image = section.settings.hubs_image
                elsif collection_card_title == 'Wall Charger' or collection_card_title == 'Car Charger'
                  assign collection_card_image = section.settings.chargers_image
                elsif collection_card_title == 'Cables' or collection_card_title == 'HDMI' or collection_card_title == 'DisplayPort' or collection_card_title == 'Mini DisplayPort' or collection_card_title == 'Audio'
                  assign collection_card_image = section.settings.cables_image
                elsif collection_card_title == 'Adapters' or collection_card_title == 'Card Readers' or collection_card_title == 'Enclosure'
                  assign collection_card_image = section.settings.accessories_image
                endif
              -%}
              {% if col == blank %}
                {% continue %}
              {% endif %}
              <a href="{{ col.url }}" class="collection-card">
                <div class="collection-card-media">
                  {% if collection_card_image != blank %}
                    {{ collection_card_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: collection_card_title, class: 'collection-card-image' }}
                  {% elsif collection_card_product != blank %}
                    {% render 'owned-product-visual',
                      product_handle: collection_card_product,
                      product_title: collection_card_title,
                      variant: 'hero',
                      width: 800,
                      height: 800,
                      class: 'collection-card-image'
                    %}
                  {% elsif col.image != blank %}
                    {{ col.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: collection_card_title, class: 'collection-card-image' }}
                  {% else %}
                    {% render 'owned-collection-visual', collection_handle: col.handle, collection_title: collection_card_title, width: 800, height: 800, class: 'collection-card-image' %}
                  {% endif %}
                </div>
                <div class="collection-card-body">
                  <h2 class="collection-card-title">{{ collection_card_title }}</h2>
                  <span class="collection-card-meta">{{ col.title }}</span>
                </div>
                <span class="collection-card-arrow" aria-hidden="true">→</span>
              </a>
            {% endfor %}
          </div>
        </section>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main list collections",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "Browse EZQuest collections by setup type, then move into the right family with a clearer idea of the ports, power path, and footprint you need."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Header note",
      "default": "Start with the family built for your setup, then use compare or support only when you need more detail."
    },
    {
      "type": "image_picker",
      "id": "hubs_image",
      "label": "Hubs card image"
    },
    {
      "type": "image_picker",
      "id": "chargers_image",
      "label": "Chargers card image"
    },
    {
      "type": "image_picker",
      "id": "cables_image",
      "label": "Cables card image"
    },
    {
      "type": "image_picker",
      "id": "accessories_image",
      "label": "Accessories card image"
    }
  ],
  "presets": [
    {
      "name": "Main list collections"
    }
  ]
}
{% endschema %}
