{% comment %} sections/about.liquid {% endcomment %}
{{ 'pages.css' | asset_url | stylesheet_tag }}

{% comment %} INTRO — official About EZQuest narrative {% endcomment %}
<section class="page-section page-section--white bg-white">
  <div class="container-shell">
    <div class="about-narrative">
      <div class="about-narrative__aside">
        <span class="about-narrative__rule" aria-hidden="true"></span>
        <p class="about-narrative__kicker">{{ section.settings.about_kicker }}</p>
      </div>
      <div class="about-narrative__body">
      {% if section.settings.about_lead != blank %}
        <p class="about-narrative__lead">{{ section.settings.about_lead }}</p>
      {% endif %}
      {{ section.settings.about_body }}
      {% if section.settings.about_closer != blank %}
        <p class="about-narrative__closer">{{ section.settings.about_closer }}</p>
      {% endif %}
      </div>
    </div>
  </div>
</section>

{% comment %} MISSION {% endcomment %}
<section class="page-section page-section--grey">
  <div class="container-shell">
    <div class="about-mission" data-animate>
      <p class="about-mission__kicker">{{ section.settings.mission_kicker }}</p>
      <p class="about-mission__statement">{{ section.settings.mission_before }}<mark class="about-mission__hl">{{ section.settings.mission_highlight }}</mark>{{ section.settings.mission_after }}</p>
    </div>
  </div>
</section>

{% comment %} WHY CHOOSE EZQUEST {% endcomment %}
{%- assign reasons = section.blocks | where: 'type', 'reason' -%}
{% if reasons.size > 0 %}
<section class="page-section page-section--white bg-white">
  <div class="container-shell">
    <div class="about-section-head">
      {% if section.settings.why_kicker != blank %}
        <p class="about-intro__kicker">{{ section.settings.why_kicker }}</p>
      {% endif %}
      <h2 class="about-section-head__heading">{{ section.settings.why_heading }}</h2>
    </div>
    <div class="why-choose-grid">
      {% for block in reasons %}
        <div class="why-card" data-animate {{ block.shopify_attributes }}>
          <h3 class="why-card__title">{{ block.settings.title }}</h3>
          <p class="why-card__body">{{ block.settings.body }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% comment %} THE EZQUEST PROMISE {% endcomment %}
{%- assign promises = section.blocks | where: 'type', 'promise' -%}
{% if promises.size > 0 %}
<section class="page-section ez-promise">
  <div class="container-shell">
    <div class="ez-promise__inner" data-animate>
      <div class="ez-promise__head">
        {% if section.settings.promise_kicker != blank %}
          <p class="ez-promise__kicker">{{ section.settings.promise_kicker }}</p>
        {% endif %}
        <h2 class="ez-promise__heading">{{ section.settings.promise_heading }}</h2>
      </div>
      <ul class="ez-promise__list">
        {% for block in promises %}
          <li class="ez-promise__item"><span class="ez-promise__check" aria-hidden="true">✓</span>{{ block.settings.text }}</li>
        {% endfor %}
      </ul>
      {% if section.settings.promise_finale_1 != blank or section.settings.promise_finale_accent != blank %}
        <p class="ez-promise__finale">{{ section.settings.promise_finale_1 }}<br>{{ section.settings.promise_finale_pre }} <span class="ez-promise__accent">{{ section.settings.promise_finale_accent }}</span>.</p>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

{%- render 'page-cta', variant: 'light', heading: section.settings.cta_heading, default: routes.collections_url, subhead: section.settings.cta_body, primary_label: section.settings.cta_label, primary_url: section.settings.cta_url -%}

