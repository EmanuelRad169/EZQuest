<section class="section-shell cart-page-section">
  <div class="container-shell">

    <div class="cart-page-header">
      <p class="section-kicker">{{ section.settings.kicker | default: 'Your Bag' }}</p>
      <h1 class="cart-page-title">
        {% if cart.item_count == 0 %}
          {{ section.settings.empty_title | default: 'Your cart is empty' }}
        {% elsif cart.item_count == 1 %}
          Cart (1 item)
        {% else %}
          Cart ({{ cart.item_count }} items)
        {% endif %}
      </h1>
    </div>

    {% if cart.item_count > 0 %}
      <div class="cart-page-layout">

        {%- comment -%} ── Line items ── {%- endcomment -%}
        <div class="cart-page-items">
          {% for item in cart.items %}
            <div class="cart-item">

              <a href="{{ item.url }}" class="cart-item-media" tabindex="-1" aria-hidden="true">
                {% if item.image != blank %}
                  {%- liquid
                    assign cart_item_height = 300
                    if item.image.aspect_ratio > 0
                      assign cart_item_height = 300 | divided_by: item.image.aspect_ratio | round
                    endif
                  -%}
                  {{ item.image | image_url: width: 300, format: 'pjpg' | image_tag: loading: 'lazy', width: 300, height: cart_item_height, alt: item.product.title, class: 'cart-item-image' }}
                {% endif %}
              </a>

              <div class="cart-item-body">
                <div class="cart-item-meta">
                  <a href="{{ item.url }}" class="cart-item-title">{{ item.product.title }}</a>
                  {% unless item.variant.title == 'Default Title' %}
                    <p class="cart-item-variant">{{ item.variant.title }}</p>
                  {% endunless %}
                  <p class="cart-item-price">{{ item.line_price | money }}</p>
                </div>

                <div class="cart-item-controls">
                  <form action="{{ routes.cart_change_url }}" method="post" class="cart-item-qty-form">
                    <input type="hidden" name="id" value="{{ item.variant.id }}">
                    <div class="cart-item-qty-group" role="group" aria-label="Quantity for {{ item.product.title | escape }}">
                      <button
                        type="submit"
                        name="quantity"
                        value="{{ item.quantity | minus: 1 }}"
                        class="cart-item-qty-btn"
                        aria-label="Decrease quantity of {{ item.product.title | escape }}"
                        {% if item.quantity <= 1 %}disabled{% endif %}
                      >–</button>
                      <span class="cart-item-qty-display" aria-live="polite">{{ item.quantity }}</span>
                      <button
                        type="submit"
                        name="quantity"
                        value="{{ item.quantity | plus: 1 }}"
                        class="cart-item-qty-btn"
                        aria-label="Increase quantity of {{ item.product.title | escape }}"
                      >+</button>
                    </div>
                  </form>

                  <form action="{{ routes.cart_change_url }}" method="post" class="cart-item-remove-form">
                    <input type="hidden" name="id" value="{{ item.variant.id }}">
                    <button type="submit" name="quantity" value="0" class="cart-item-remove">Remove</button>
                  </form>
                </div>
              </div>

            </div>
          {% endfor %}
        </div>

        {%- comment -%} ── Order summary panel ── {%- endcomment -%}
        <div class="cart-page-summary">
          <div class="cart-summary-panel">
            <h2 class="cart-summary-heading">{{ section.settings.summary_heading | default: 'Order summary' }}</h2>

            {%- liquid
              assign free_ship_threshold = 9000
              assign remaining_cents = free_ship_threshold | minus: cart.total_price
            -%}
            {% if remaining_cents > 0 %}
              <div class="cart-shipping-bar">
                <p class="cart-shipping-bar__label">
                  {{ section.settings.free_ship_prefix | default: 'Add' }} {{ remaining_cents | money }} {{ section.settings.free_ship_suffix | default: 'more for free shipping' }}
                </p>
                <div class="cart-shipping-bar__track" role="presentation">
                  <div
                    class="cart-shipping-bar__fill"
                    style="width: {{ cart.total_price | times: 100 | divided_by: free_ship_threshold | at_most: 100 }}%"
                    role="progressbar"
                    aria-valuenow="{{ cart.total_price | times: 100 | divided_by: free_ship_threshold | round }}"
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-label="Free shipping progress"
                  ></div>
                </div>
              </div>
            {% else %}
              <div class="cart-shipping-bar cart-shipping-bar--complete">
                <p class="cart-shipping-bar__label">{{ section.settings.free_ship_done | default: 'You qualify for free shipping' }}</p>
              </div>
            {% endif %}

            {% if cart.total_discount > 0 %}
              <div class="cart-summary-row">
                <span>{{ section.settings.savings_label | default: 'Savings' }}</span>
                <span class="cart-summary-savings">–{{ cart.total_discount | money }}</span>
              </div>
            {% endif %}

            <div class="cart-summary-row cart-summary-total">
              <span>{{ section.settings.subtotal_label | default: 'Subtotal' }}</span>
              <span>{{ cart.total_price | money }}</span>
            </div>

            <p class="cart-summary-note">{{ section.settings.summary_note | default: 'Taxes and shipping calculated at checkout.' }}</p>

            <div class="cart-summary-trust" role="list" aria-label="Checkout assurances">
              <span class="cart-trust-item" role="listitem">
                <span class="cart-trust-icon" aria-hidden="true">{% render 'icon', name: 'shield' %}</span>
                {{ section.settings.trust_1 | default: 'Secure checkout' }}
              </span>
              <span class="cart-trust-item" role="listitem">
                <span class="cart-trust-icon" aria-hidden="true">{% render 'icon', name: 'truck' %}</span>
                {{ section.settings.trust_2 | default: 'Free shipping over $90' }}
              </span>
              <span class="cart-trust-item" role="listitem">
                <span class="cart-trust-icon" aria-hidden="true">{% render 'icon', name: 'shield' %}</span>
                {{ section.settings.trust_3 | default: 'Up to 2-year warranty' }}
              </span>
            </div>

            <a href="/checkout" class="cart-checkout-btn">
              {{ section.settings.checkout_label | default: 'Proceed to checkout' }}
            </a>

            <div class="cart-continue-btn">
              {% render 'button', label: section.settings.continue_label | default: 'Continue shopping', url: routes.collections_url, style: 'secondary' %}
            </div>

          </div>
        </div>

      </div>
    {% else %}

      <div class="cart-empty-state">
        <p class="cart-empty-body">{{ section.settings.empty_body | default: "You haven't added anything yet. Browse the product families to find the right hub, dock, charger, or accessory for your setup." }}</p>
        <div class="cart-empty-actions">
          {% render 'button', label: section.settings.empty_button | default: 'Browse products', url: routes.collections_url, style: 'primary' %}
          <a href="/pages/help-me-choose" class="site-meta-link">{{ section.settings.empty_link | default: 'Not sure? Get setup guidance' }}</a>
        </div>
      </div>

    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Main cart",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Your Bag" },
    { "type": "text", "id": "empty_title", "label": "Empty-cart title", "default": "Your cart is empty" },
    { "type": "header", "content": "Order summary" },
    { "type": "text", "id": "summary_heading", "label": "Heading", "default": "Order summary" },
    { "type": "text", "id": "free_ship_prefix", "label": "Free-ship message prefix", "default": "Add" },
    { "type": "text", "id": "free_ship_suffix", "label": "Free-ship message suffix", "default": "more for free shipping" },
    { "type": "text", "id": "free_ship_done", "label": "Free-ship qualified message", "default": "You qualify for free shipping" },
    { "type": "text", "id": "savings_label", "label": "Savings label", "default": "Savings" },
    { "type": "text", "id": "subtotal_label", "label": "Subtotal label", "default": "Subtotal" },
    { "type": "text", "id": "summary_note", "label": "Summary note", "default": "Taxes and shipping calculated at checkout." },
    { "type": "text", "id": "trust_1", "label": "Trust item 1", "default": "Secure checkout" },
    { "type": "text", "id": "trust_2", "label": "Trust item 2", "default": "Free shipping over $90" },
    { "type": "text", "id": "trust_3", "label": "Trust item 3", "default": "Up to 2-year warranty" },
    { "type": "text", "id": "checkout_label", "label": "Checkout button", "default": "Proceed to checkout" },
    { "type": "text", "id": "continue_label", "label": "Continue-shopping button", "default": "Continue shopping" },
    { "type": "header", "content": "Empty state" },
    { "type": "textarea", "id": "empty_body", "label": "Empty body", "default": "You haven't added anything yet. Browse the product families to find the right hub, dock, charger, or accessory for your setup." },
    { "type": "text", "id": "empty_button", "label": "Empty button", "default": "Browse products" },
    { "type": "text", "id": "empty_link", "label": "Empty guidance link", "default": "Not sure? Get setup guidance" }
  ]
}
{% endschema %}
