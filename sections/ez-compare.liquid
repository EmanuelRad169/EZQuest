{% comment %} Native product comparison page — reads the localStorage compare list and renders a table from the server-rendered index below. {% endcomment %}
{{ 'ez-compare.css' | asset_url | stylesheet_tag }}

<section class="ez-compare-page section-shell">
  <div class="container-shell">
    <div class="ez-compare-head">
      {% if section.settings.kicker != blank %}<p class="section-kicker">{{ section.settings.kicker | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h1 class="ez-compare-heading">{{ section.settings.heading | escape }}</h1>{% endif %}
      {% if section.settings.body != blank %}<p class="ez-compare-body">{{ section.settings.body | escape }}</p>{% endif %}
    </div>

    <div id="ez-compare-root" aria-live="polite"></div>
  </div>
</section>

{%- comment -%} Server-rendered product index (market-aware pricing + spec metafields) {%- endcomment -%}
{% paginate collections.all.products by 250 %}
<script type="application/json" id="ez-compare-index">
{
{%- for product in collections.all.products -%}
{%- unless forloop.first -%},{%- endunless -%}
"{{ product.id }}": {
"title": {{ product.title | json }},
"url": {{ product.url | json }},
"img": {% if product.featured_image %}{{ product.featured_image | image_url: width: 260 | json }}{% else %}""{% endif %},
"price": {{ product.price | money | json }},
{% if product.compare_at_price > product.price %}"compareAt": {{ product.compare_at_price | money | json }},{% endif %}
"sku": {{ product.selected_or_first_available_variant.sku | json }},
"type": {{ product.type | json }},
"vendor": {{ product.vendor | json }},
"connector": {{ product.metafields.ezquest.compare_connector_type.value | json }},
"form": {{ product.metafields.ezquest.compare_form_factor.value | json }},
"power": {{ product.metafields.ezquest.compare_charging_power.value | json }},
"portability": {{ product.metafields.ezquest.compare_portability.value | json }},
"bestfor": {{ product.metafields.ezquest.best_for.value | json }},
"warranty": {{ product.metafields.custom.warranty_years.value | json }}
}
{%- endfor -%}
}
</script>
{% endpaginate %}

{% schema %}
{
  "name": "Compare page",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Compare" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Compare products side by side" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Add products with the compare icon while you browse, then review ports, power, and specs here." }
  ],
  "presets": [{ "name": "Compare page" }]
}
{% endschema %}
