{%- comment -%}
  Drivers page (Liquid template so it syncs from GitHub; JSON page templates do not).
  The download-center section auto-detects page.handle == 'drivers' and renders the
  global Downloads metaobjects filtered to the "Driver" type — same data as the
  Downloads page's Driver tab, shown directly here.
{%- endcomment -%}

{{ 'page-hero.css' | asset_url | stylesheet_tag }}
<style>
  #page-drivers-hero .page-hero { background-color: #020617; min-height: 250px; }
  #page-drivers-hero .page-hero__overlay { background: transparent; }
</style>

<div id="page-drivers-hero">
  <section class="page-hero page-hero--gradient" aria-label="{{ page.title | escape }}">
    <div class="page-hero__overlay"></div>
    <div class="page-hero__inner container-shell">
      <nav class="page-hero__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span class="page-hero__breadcrumb-sep" aria-hidden="true">/</span>
        <span aria-current="page">{{ page.title | escape }}</span>
      </nav>
      <p class="page-hero__kicker">Support</p>
      <h1 class="page-hero__heading">{{ page.title | escape }}</h1>
      <p class="page-hero__subheading">Download the latest drivers for your EZQuest device.</p>
    </div>
  </section>
</div>

{% section 'download-center' %}
