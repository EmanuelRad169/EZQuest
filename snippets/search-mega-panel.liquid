{%- liquid
  assign hub_product = all_products['usb-4-dual-display-8-in-1-hub-pro-series']
  assign dock_product = all_products['65w-gan-usb-c-pd-wall-charger']
-%}
<section
  id="site-header-search-panel"
  class="search-mega-panel"
  hidden
  data-search-mega-panel
  aria-label="Search the EZQuest storefront"
>
  <div class="search-mega-surface card-elevated rounded-panel bg-white p-5 shadow-lift lg:p-6">
    <div class="grid gap-5 xl:gap-6">
      <div class="grid gap-4 xl:grid-cols-12 xl:items-start">
        <div class="grid gap-3 xl:col-span-11">
          <div class="space-y-2">
            <p class="search-mega-label">Search EZQuest</p>
            <h2 class="type-heading text-heading-lg">Search products or support</h2>
          </div>

          <div class="search-panel" data-search-panel>
            <form action="{{ routes.search_url }}" method="get" class="search-mega-form grid min-h-14 flex-1 items-center gap-3 rounded-2xl border border-slate-200/90 bg-slate-50/70 px-4" role="search">
              <label class="sr-only" for="site-header-search-input">Search EZQuest</label>
              <span class="search-mega-form-icon inline-flex h-10 w-10 items-center justify-center text-slate-700">{% render 'icon', name: 'search' %}</span>
              <input
                id="site-header-search-input"
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="Search products, manuals, compatibility, or setup help"
                class="search-mega-input min-w-0 flex-1 bg-transparent text-body-lg text-slate-950 outline-none"
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                enterkeyhint="search"
                data-search-input
                aria-label="Search products"
                aria-autocomplete="list"
                aria-expanded="false"
                aria-controls="search-results"
              >
              <button type="button" class="search-panel__clear search-mega-clear" data-search-clear aria-label="Clear search" hidden>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 3l8 8M11 3L3 11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
              </button>
              <input type="hidden" name="type" value="product,page,article">
              {% render 'button', label: 'Search', tag: 'button', type: 'submit', style: 'primary', size: 'sm', class: 'search-mega-submit' %}
            </form>

            <div
              class="search-results"
              id="search-results"
              data-search-results
              role="listbox"
              aria-label="Search results"
              hidden
            ></div>
          </div>
        </div>

        <button type="button" class="button-icon search-mega-close xl:col-span-1 xl:justify-self-end" data-search-mega-close aria-label="Close search">
          {% render 'icon', name: 'close' %}
        </button>
      </div>

      <div class="grid gap-5 border-t border-slate-200/70 pt-5 xl:grid-cols-12 xl:gap-6 xl:pt-6">
        <aside class="grid content-start gap-4 xl:col-span-4 2xl:col-span-3">
          <div class="search-mega-block card-soft grid gap-2.5 p-4">
            <div class="space-y-2">
              <p class="search-mega-label">Suggested searches</p>
            </div>
            <div class="search-mega-chip-list flex flex-wrap gap-2">
              <a href="{{ routes.search_url }}?q=pro+dock" class="search-mega-chip inline-flex min-h-8 items-center rounded-full border border-slate-200/90 bg-slate-50/70 px-3 text-xs font-medium text-slate-700 no-underline transition duration-200 hover:-translate-y-px hover:border-slate-300 hover:bg-white hover:text-slate-950">Pro dock</a>
              <a href="{{ routes.search_url }}?q=usb-c+hub" class="search-mega-chip inline-flex min-h-8 items-center rounded-full border border-slate-200/90 bg-slate-50/70 px-3 text-xs font-medium text-slate-700 no-underline transition duration-200 hover:-translate-y-px hover:border-slate-300 hover:bg-white hover:text-slate-950">USB-C hub</a>
              <a href="{{ routes.search_url }}?q=compatibility" class="search-mega-chip inline-flex min-h-8 items-center rounded-full border border-slate-200/90 bg-slate-50/70 px-3 text-xs font-medium text-slate-700 no-underline transition duration-200 hover:-translate-y-px hover:border-slate-300 hover:bg-white hover:text-slate-950">Compatibility</a>
              <a href="{{ routes.search_url }}?q=manual" class="search-mega-chip inline-flex min-h-8 items-center rounded-full border border-slate-200/90 bg-slate-50/70 px-3 text-xs font-medium text-slate-700 no-underline transition duration-200 hover:-translate-y-px hover:border-slate-300 hover:bg-white hover:text-slate-950">Manuals</a>
            </div>
          </div>

          <div class="search-mega-block card-soft grid gap-2.5 p-4">
            <div class="space-y-2">
              <p class="search-mega-label">Quick links</p>
            </div>
            <div class="search-mega-link-stack grid gap-2">
              <a href="/pages/compatibility" class="search-mega-quicklink text-sm font-medium text-slate-900 no-underline transition duration-200">Check compatibility</a>
              <a href="/pages/support" class="search-mega-quicklink text-sm font-medium text-slate-900 no-underline transition duration-200">Open support center</a>
            </div>
          </div>
        </aside>

        <div class="grid gap-4 xl:col-span-8 2xl:col-span-9">
          <div class="space-y-2">
            <p class="search-mega-label">Suggested products</p>
            <h2 class="text-heading-base font-medium tracking-title text-slate-950">Quick starts</h2>
          </div>

          <div class="search-mega-results" aria-live="polite" aria-busy="false" data-search-suggestions>
            <div class="search-mega-products grid gap-4 xl:grid-cols-2" data-search-products>
              {% if hub_product != blank %}
                {% render 'mega-menu-stage-card',
                  product: hub_product,
                  media_context: 'search',
                  eyebrow: 'Popular',
                  show_descriptor: true,
                  card_class: 'search-mega-stage-card'
                %}
              {% endif %}
              {% if dock_product != blank %}
                {% render 'mega-menu-stage-card',
                  product: dock_product,
                  media_context: 'search',
                  eyebrow: 'Power',
                  show_descriptor: true,
                  card_class: 'search-mega-stage-card'
                %}
              {% endif %}
            </div>

            <div class="search-mega-skeleton grid gap-4 xl:grid-cols-2" aria-hidden="true" hidden data-search-skeleton>
              {% for i in (1..2) %}
                <div class="search-skeleton-card card-base overflow-hidden">
                  <div class="search-skeleton-media"></div>
                  <div class="search-skeleton-body">
                    <div class="search-skeleton-line"></div>
                    <div class="search-skeleton-line search-skeleton-line--short"></div>
                    <div class="search-skeleton-line search-skeleton-line--price"></div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Borderless search input — keep the soft fill, drop the outline */
  .search-mega-form { border: 0 !important; box-shadow: none !important; }
  .search-mega-form:focus-within { box-shadow: 0 0 0 2px rgba(254, 211, 0, 0.35) !important; }

  /* Predictive (type-ahead) results list — injected by predictive-search.js */
  .search-results { display: grid; gap: 16px; margin-top: 12px; }
  .search-results[hidden] { display: none; }
  .predictive-group__label { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #94a3b8; margin: 0 0 8px; }
  .predictive-group__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }

  .search-result-item { display: flex; align-items: center; gap: 14px; padding: 10px 12px; border-radius: 14px; text-decoration: none; color: #0f172a; border: 1px solid transparent; transition: background 0.15s, box-shadow 0.15s, border-color 0.15s, transform 0.15s; }
  .search-result-item:hover,
  .search-result-item[aria-selected="true"] { background: #ffffff; border-color: #eef2f7; box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08); transform: translateY(-1px); }
  .search-result-item__img-wrap { flex: 0 0 54px; width: 54px; height: 54px; border-radius: 12px; overflow: hidden; background: #f1f5f9; border: 1px solid #e9eef5; display: flex; align-items: center; justify-content: center; padding: 4px; }
  .search-result-item__img-wrap img { width: 100%; height: 100%; object-fit: contain; }
  .search-result-item__img-fallback { width: 100%; height: 100%; border-radius: 8px; background: #e2e8f0; }
  .search-result-item__text { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .search-result-item__title { font-size: 14.5px; font-weight: 600; line-height: 1.3; color: #0f172a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .search-result-item__type { font-size: 12px; color: #94a3b8; font-weight: 500; line-height: 1.3; }
  .search-result-item__price { flex: 0 0 auto; margin-left: auto; padding-left: 12px; font-size: 14.5px; font-weight: 700; color: #0f172a; white-space: nowrap; }

  .predictive-text-result { display: block; padding: 8px 10px; border-radius: 10px; font-size: 14px; color: #0f172a; text-decoration: none; transition: background 0.15s; }
  .predictive-text-result:hover { background: #f1f5f9; }

  .search-results__footer { display: inline-flex; align-items: center; gap: 4px; margin-top: 4px; padding: 10px 12px; font-size: 13px; font-weight: 600; color: #0f172a; text-decoration: none; border-radius: 10px; transition: background 0.15s; }
  .search-results__footer:hover { background: #f1f5f9; }

  .search-results__empty { padding: 14px 12px; font-size: 14px; color: #64748b; }
  .search-results__empty-link { display: inline-block; margin-top: 6px; color: #0f172a; font-weight: 600; text-decoration: none; }

  .search-result-item__title mark,
  .predictive-text-result mark,
  .search-results__footer mark { background: #FEF3C7; color: inherit; padding: 0 1px; border-radius: 2px; }
</style>
